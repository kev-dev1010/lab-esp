# Configuracoes basicas do projeto
APP_ENV=development
APP_PORT=3000

# Identidade do projeto
PROJECT_NAME=lab-esp
PROJECT_GOAL=Base confiavel para testes com ESP32, sensores e comunicacao serial

# IA
LLM_PROVIDER=OpenAI
LLM_MODEL=GPT-5.4 Thinking
LLM_BASE_URL=
LLM_API_KEY=
TOKEN_BUDGET_PER_MONTH=

# Deploy
DEPLOY_TARGET=local+docker
RELEASE_STRATEGY=manual-branch-or-tag
ROLLBACK_STRATEGY=rollback-to-last-stable-tag
