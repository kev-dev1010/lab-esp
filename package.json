{
  "name": "lab-esp",
  "version": "0.1.0",
  "private": true,
  "description": "Base confiavel para testes com ESP32, sensores e comunicacao serial.",
  "type": "module",
  "main": "dist/src/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "context:server": "tsx src/context-server.ts",
    "context:check": "./scripts/context-check",
    "ai:flow": "node --import tsx src/ai-flow.ts",
    "build": "tsc -p tsconfig.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "./scripts/ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  }
}
